namespace mini_ffi {
  u32 api_version();

  [Throws=AppError]
  AppSnapshot start(PlatformCapabilities capabilities);

  [Throws=AppError]
  CommandOutcome dispatch(AppSnapshot snapshot, AppCommand command);

  [Throws=RootError]
  boolean is_device_delegated(sequence<u8> root_kel_bytes, string device_did);
};

callback interface StorageCipher {
  [Throws=StorageCipherError]
  sequence<u8> encrypt(sequence<u8> plaintext);

  [Throws=StorageCipherError]
  sequence<u8> decrypt(sequence<u8> ciphertext);
};

callback interface BleRadio {
  [Throws=BleRadioError]
  void write_chunk(sequence<u8> chunk);

  [Throws=BleRadioError]
  sequence<u8> read_chunk();

  [Throws=BleRadioError]
  sequence<u8>? try_read_chunk();

  // Best-effort: close the underlying platform connection (GATT
  // disconnect/cancelConnection). Called from Rust exactly once, when the
  // bearer wrapping this radio is dropped for any reason -- including a
  // `mini_mesh::MeshNode` pruning this link after a protocol or send
  // failure, not only an explicit `close()`/`disconnect()` call a caller
  // makes directly. No `Throws`: a failure here has nothing further for
  // Rust to act on, the same reasoning `RadioAdapter`'s other methods
  // already collapse every platform-specific failure into one error for.
  void disconnect();
};

interface BleBearerHandle {
  constructor(BleRadio radio, u32 mtu);

  [Throws=BleBearerError]
  void send(sequence<u8> frame);

  [Throws=BleBearerError]
  sequence<u8> recv();

  [Throws=BleBearerError]
  sequence<u8>? try_recv();
};

dictionary MeshMessage {
  sequence<u8> id;
  sequence<u8> payload;
};

interface MeshHandle {
  constructor();

  [Throws=MeshError]
  void add_dialed_link(BleRadio radio, u32 mtu);

  [Throws=MeshError]
  void add_accepted_link(BleRadio radio, u32 mtu);

  u32 link_count();

  [Throws=MeshError]
  sequence<u8> broadcast(sequence<u8> payload);

  sequence<MeshMessage> poll();

  void flush_reflood();

  sequence<MeshMessage> poll_and_flush();
};

interface RootCore {
  constructor();

  [Throws=RootError, Name=restore]
  constructor(sequence<u8> ciphertext, StorageCipher cipher);

  boolean has_root();

  string? root_did();

  [Throws=RootError]
  string create_root();

  [Throws=RootError]
  string create_device();

  [Throws=RootError]
  void revoke_device(string device_did);

  sequence<string> delegated_devices();

  [Throws=RootError]
  sequence<u8> root_kel();

  [Throws=RootError]
  sequence<u8> begin_device_enrollment(string root_did);

  [Throws=RootError]
  sequence<u8> approve_device_enrollment(sequence<u8> request);

  [Throws=RootError]
  string finish_device_enrollment(sequence<u8> approval);

  [Throws=RootError]
  void revoke_delegated_device(string device_did);

  [Throws=RootError]
  sequence<u8> persist_state(StorageCipher cipher);

  [Throws=PairingError]
  PairingOfferView begin_pairing_offer(string display_name, string advertised_ip, u64 now_ms, u64 ttl_ms);

  [Throws=PairingError]
  PairingContact accept_pairing_offer(string qr_payload, string display_name, u64 now_ms, u64 connect_timeout_ms);

  [Throws=PairingError]
  PairingContact finish_pairing_offer(u64 now_ms, u64 accept_timeout_ms, u64 read_timeout_ms);

  sequence<PairingContact> pairing_contacts();

  sequence<sequence<u8>> pairing_follow_objects();

  [Throws=MessagingFfiError]
  string send_message(ConversationSecretHandle secret, u64 now_ms, MessageDraftInput draft);

  [Throws=MessagingFfiError]
  ConversationScanView scan_conversation(ConversationSecretHandle secret);
};

dictionary PairingContact {
  string did;
  string display_name;
};

dictionary PairingOfferView {
  string qr_payload;
  u64 expires_at_ms;
  u16 listen_port;
};

// A conversation's opaque storage route bound to its symmetric key -- 32
// bytes each. See crates/mini-ffi/src/messaging.rs's module doc comment for
// what establishing one of these safely actually requires; this crate does
// not generate, exchange, or store these on its own initiative.
dictionary ConversationSecretHandle {
  sequence<u8> route;
  sequence<u8> key;
};

enum MessageKindInput {
  "Text",
  "System",
  "ReceiptDelivered",
  "ReceiptRead",
};

dictionary MessageDraftInput {
  MessageKindInput kind;
  string body;
  string? reply_to;
  sequence<string> attachments;
  string? receipt_for;
};

dictionary ReceivedMessageView {
  string envelope_id;
  string author_human;
  string author_device;
  u64 timestamp_ms;
  u64 sequence;
  MessageKindInput kind;
  string body;
  string? reply_to;
  sequence<string> attachments;
  string? receipt_for;
  // Only ever true for a message claiming to be authored by this device's
  // own root and one of this process's own currently-known devices,
  // verified against that device's own current KEL -- see messaging.rs's
  // module doc comment. Never true for another person's DID.
  boolean signature_verified;
};

dictionary ConversationScanView {
  sequence<ReceivedMessageView> messages;
  sequence<string> rejected;
};

enum BackgroundableOperation {
  "LanQrPairingExchange",
  "BleBearerTransfer",
};

enum LifecyclePhase {
  "InFlight",
  "AtCheckpoint",
  "Suspended",
  "Completed",
  "FailedClosed",
};

enum LifecycleFailureReason {
  "Timeout",
  "PeerDisconnected",
  "PlatformTerminated",
};

enum SuspendDecision {
  "SafeToSuspend",
  "MustCompleteOrFailClosed",
};

interface OperationLifecycle {
  [Name=begin]
  constructor(BackgroundableOperation operation);

  BackgroundableOperation operation();

  LifecyclePhase phase();

  LifecycleFailureReason? failure_reason();

  [Throws=LifecycleError]
  void mark_checkpoint();

  [Throws=LifecycleError]
  void begin_next_step();

  SuspendDecision request_suspend();

  [Throws=LifecycleError]
  void resume_from_suspend();

  [Throws=LifecycleError]
  void fail_closed(LifecycleFailureReason reason);

  [Throws=LifecycleError]
  void complete();
};

dictionary PlatformCapabilities {
  boolean secure_key_storage;
  boolean hardware_backed_keys;
  boolean screen_lock;
  boolean biometric_unlock;
};

enum SecurityReadiness {
  "SecureStorageUnavailable",
  "SoftwareProtected",
  "HardwareProtected",
};

enum OnboardingStage {
  "Welcome",
  "RootSafety",
  "RootCreationReady",
};

dictionary AppSnapshot {
  u32 api_version;
  u64 generation;
  OnboardingStage onboarding_stage;
  SecurityReadiness security_readiness;
  boolean screen_lock;
  boolean biometric_unlock;
};

enum AppAction {
  "Refresh",
  "Continue",
  "Back",
};

dictionary AppCommand {
  u32 api_version;
  string request_id;
  PlatformCapabilities capabilities;
  AppAction action;
};

enum AppEventKind {
  "SnapshotChanged",
  "SecureStorageRequired",
  "RootCreationPending",
};

dictionary AppEvent {
  string request_id;
  AppEventKind kind;
};

dictionary CommandOutcome {
  AppSnapshot snapshot;
  sequence<AppEvent> events;
};

[Error]
enum AppError {
  "UnsupportedApiVersion",
  "InvalidPlatformCapabilities",
  "InconsistentSnapshot",
  "InvalidRequest",
  "InvalidTransition",
  "GenerationOverflow",
};

[Error]
enum RootError {
  "RootAlreadyExists",
  "NoRoot",
  "UnknownDevice",
  "Identity",
  "CorruptState",
  "Storage",
  "EnrollmentAlreadyPending",
  "NoPendingEnrollment",
  "DelegatorMismatch",
};

[Error]
enum PairingError {
  "NoRoot",
  "NoDevice",
  "InvalidAddress",
  "InvalidQr",
  "Expired",
  "Replayed",
  "AlreadyListening",
  "NoPendingOffer",
  "Capacity",
  "InvalidTimeout",
  "Protocol",
  "Io",
};

[Error]
enum MessagingFfiError {
  "NoRoot",
  "NoDevice",
  "InvalidSecret",
  "InvalidMessage",
  "LimitExceeded",
  "CorruptState",
  "Protocol",
};

[Error]
enum StorageCipherError {
  "Failed",
};

[Error]
enum BleRadioError {
  "Failed",
};

[Error]
enum BleBearerError {
  "RadioFailed",
  "FrameTooLarge",
  "MtuTooSmall",
  "TooManyChunks",
  "Protocol",
};

[Error]
enum MeshError {
  "HandshakeFailed",
  "PayloadTooLarge",
};

[Error]
enum LifecycleError {
  "AlreadyTerminal",
  "NotSuspended",
  "NotInFlight",
  "NotAtCheckpoint",
};
