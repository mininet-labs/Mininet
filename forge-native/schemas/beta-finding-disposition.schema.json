{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Beta Finding Disposition payload",
  "description": "Append-only Forge-native semantic schema for mininet.beta/finding-disposition/v1. A disposition never mutates or deletes the original finding. Adapters must run tools/check_beta_payload.py; x-mininet keywords and did-mini format checks are mandatory. Signed-object Rust validation remains required.",
  "type": "object",
  "required": [
    "finding_id",
    "state",
    "rationale"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "format": "mininet-object-id"
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "mininet-object-id"
    },
    "resolved_in": {
      "type": [
        "string",
        "null"
      ],
      "format": "mininet-object-id"
    },
    "state": {
      "enum": [
        "accepted",
        "duplicate",
        "needs-information",
        "fixed",
        "cannot-reproduce",
        "rejected"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "x-mininet-maxUtf8Bytes": 16384
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "fixed"
          }
        }
      },
      "then": {
        "required": [
          "resolved_in"
        ],
        "properties": {
          "resolved_in": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
