{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Beta Finding Disposition payload",
  "description": "Append-only Forge-native semantic schema for mininet.beta/finding-disposition/v1. A disposition never mutates or deletes the original finding.",
  "type": "object",
  "required": ["finding_id", "state", "rationale"],
  "properties": {
    "finding_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": ["string", "null"] },
    "resolved_in": { "type": ["string", "null"] },
    "state": {
      "enum": [
        "accepted",
        "duplicate",
        "needs-information",
        "fixed",
        "cannot-reproduce",
        "rejected"
      ]
    },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 16384 }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "fixed" } } },
      "then": {
        "required": ["resolved_in"],
        "properties": { "resolved_in": { "type": "string", "minLength": 1 } }
      }
    }
  ],
  "additionalProperties": false
}
