{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Beta Finding payload",
  "description": "Forge-native semantic schema for mininet.beta/finding/v1. Deliberately contains no contributor DID, username, legal name, persistent pseudonym, reputation id, payment destination, or reward account.",
  "type": "object",
  "required": [
    "campaign_id",
    "submission_tag",
    "evidence_class",
    "severity",
    "component",
    "summary",
    "environment",
    "steps",
    "expected",
    "observed",
    "evidence",
    "limitations",
    "privacy_redacted"
  ],
  "properties": {
    "campaign_id": { "type": "string", "minLength": 1 },
    "submission_tag": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "evidence_class": {
      "enum": [
        "physical-device",
        "emulator",
        "rust-toolchain",
        "research",
        "external-review",
        "accessibility",
        "other"
      ]
    },
    "severity": { "enum": ["observation", "low", "medium", "high", "critical"] },
    "component": { "type": "string", "minLength": 1, "maxLength": 512 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 512 },
    "environment": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "steps": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "expected": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "observed": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "limitations": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "privacy_redacted": { "const": true }
  },
  "additionalProperties": false
}
