{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParliamentEmergencyOrder payload",
  "type": "object",
  "required": ["order_id", "action", "exact_target_digest", "issued_at", "expires_at", "evidence_refs"],
  "properties": {
    "order_id": {"type": "string", "minLength": 1},
    "action": {"enum": ["p0-warning", "p1-warning", "release-quarantine", "critical-workaround"]},
    "exact_target_digest": {"type": "string", "minLength": 16},
    "issued_at": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "integer", "minimum": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "ratification_motion_id": {"type": "string"}
  },
  "additionalProperties": false
}
