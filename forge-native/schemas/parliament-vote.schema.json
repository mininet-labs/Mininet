{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParliamentVote payload",
  "type": "object",
  "required": ["motion_id", "seat_id", "term_id", "choice", "exact_state_digest"],
  "properties": {
    "motion_id": {"type": "string", "minLength": 1},
    "seat_id": {"type": "integer", "minimum": 0},
    "term_id": {"type": "string", "minLength": 1},
    "choice": {"enum": ["yes", "no", "abstain"]},
    "exact_state_digest": {"type": "string", "minLength": 16},
    "conflict_recusal_ref": {"type": "string"}
  },
  "additionalProperties": false
}
